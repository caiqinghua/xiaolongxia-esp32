# Replace reviewed BLUFI sources and scoped BTA hooks, never the global SDK.
get_filename_component(AUDREAM_BLUFI_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(AUDREAM_BLUFI_RELATIVE "common/btc/profile/esp/blufi/bluedroid_host/esp_blufi.c")
set(AUDREAM_BLUFI_SOURCE_SHA256 "094c94379434b502c120d6e695616d91bc16d3ef60811e353162b1711af11985")
set(AUDREAM_BLUFI_REVIEWED
    "${AUDREAM_BLUFI_RELATIVE}|${AUDREAM_BLUFI_SOURCE_SHA256}"
    "common/api/esp_blufi_api.c|6c3094d62400f0c67f6cf262512a71e05dc4e6b7f0e462379bbae884b8fb7361"
    "common/btc/profile/esp/blufi/blufi_prf.c|00c7a39c77b5c71d0b8d2b2aed5a3eed63d56ca8ff2a0e40b855ed8eefba4992"
    "common/btc/profile/esp/blufi/blufi_protocol.c|604adbbd16f0f221d12daeb0deae0a804069f8862a37056288dd3350a86d4df8"
    "host/bluedroid/bta/gatt/bta_gatts_api.c|5ba33a2d78f3a2a03de2a42ee6105b5774d328a8bf6725a772156db9e6045160"
    "host/bluedroid/bta/gatt/bta_gatts_act.c|2449bbe42d834a576a705de7686354443e473a2fee5f95a52d30bd107cf74323"
    "host/bluedroid/stack/l2cap/l2c_link.c|ae7c6eed4d84c56bf79e3948ccabbb822d9eff294ff6564e6762aaf355ae3cf0")
set(AUDREAM_BLUFI_BTA_HEADER "host/bluedroid/bta/gatt/include/bta_gatts_int.h")

function(audream_prepare_blufi_overlay component_dir output_dir)
    file(MAKE_DIRECTORY "${output_dir}")
    foreach(entry IN LISTS AUDREAM_BLUFI_REVIEWED)
        string(REPLACE "|" ";" fields "${entry}")
        list(GET fields 0 relative)
        list(GET fields 1 expected_hash)
        file(SHA256 "${component_dir}/${relative}" actual_hash)
        if(NOT actual_hash STREQUAL expected_hash)
            message(FATAL_ERROR "Audream BLUFI overlay requires the reviewed ESP-IDF v5.5.4 source: ${relative}")
        endif()
        get_filename_component(name "${relative}" NAME)
        configure_file("${component_dir}/${relative}" "${output_dir}/${name}" COPYONLY)
    endforeach()
    file(SHA256 "${component_dir}/${AUDREAM_BLUFI_BTA_HEADER}" bta_header_hash)
    if(NOT bta_header_hash STREQUAL "dad07b8c1ef33922c20bfb6110e08c327e4113ad3fd32871af3a490786240946")
        message(FATAL_ERROR "Audream BLUFI overlay requires the reviewed BTA argument layout")
    endif()
    find_program(AUDREAM_BLUFI_GIT git REQUIRED)
    get_filename_component(ceiling "${output_dir}/.." REALPATH)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "GIT_CEILING_DIRECTORIES=${ceiling}"
        "${AUDREAM_BLUFI_GIT}" apply --recount --unidiff-zero
        "${AUDREAM_BLUFI_ROOT}/patches/esp-idf-5.5.4-blufi-security.patch"
        WORKING_DIRECTORY "${output_dir}" RESULT_VARIABLE result ERROR_VARIABLE failure)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Failed to apply Audream BLUFI overlay: ${failure}")
    endif()
    foreach(entry IN LISTS AUDREAM_BLUFI_REVIEWED)
        string(REPLACE "|" ";" fields "${entry}")
        list(GET fields 0 relative)
        list(GET fields 1 original_hash)
        get_filename_component(name "${relative}" NAME)
        file(SHA256 "${output_dir}/${name}" patched_hash)
        if(patched_hash STREQUAL original_hash)
            message(FATAL_ERROR "Audream BLUFI source was not patched: ${relative}")
        endif()
    endforeach()
endfunction()

function(audream_enable_blufi_overlay)
    if(NOT CONFIG_AUDREAM_WATCH_DEVICE_PAIRING)
        return()
    endif()
    if(NOT "${IDF_VERSION_MAJOR}.${IDF_VERSION_MINOR}.${IDF_VERSION_PATCH}" STREQUAL "5.5.4")
        message(FATAL_ERROR "Audream BLUFI overlay requires ESP-IDF version 5.5.4")
    endif()
    if(NOT CONFIG_AUDREAM_WATCH_ANCS OR NOT CONFIG_BT_BLUEDROID_ENABLED OR CONFIG_BT_BLUFI_BLE_SMP_ENABLE)
        message(FATAL_ERROR "Audream secure BLUFI requires the shared native security owner, not SDK automatic SMP")
    endif()
    idf_component_get_property(component_dir bt COMPONENT_DIR)
    idf_component_get_property(component_lib bt COMPONENT_LIB)
    set(output_dir "${CMAKE_BINARY_DIR}/audream_components/blufi")
    audream_prepare_blufi_overlay("${component_dir}" "${output_dir}")
    get_target_property(source_dir ${component_lib} SOURCE_DIR)
    get_target_property(sources ${component_lib} SOURCES)
    set(replacements)
    set(count 0)
    set(seen)
    foreach(source IN LISTS sources)
        get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${source_dir}")
        set(replaced OFF)
        foreach(entry IN LISTS AUDREAM_BLUFI_REVIEWED)
            string(REPLACE "|" ";" fields "${entry}")
            list(GET fields 0 relative)
            if(absolute STREQUAL "${component_dir}/${relative}")
                get_filename_component(name "${relative}" NAME)
                list(APPEND replacements "${output_dir}/${name}")
                list(APPEND seen "${relative}")
                math(EXPR count "${count} + 1")
                set(replaced ON)
            endif()
        endforeach()
        if(NOT replaced)
            list(APPEND replacements "${source}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES seen)
    list(LENGTH seen unique_count)
    list(LENGTH AUDREAM_BLUFI_REVIEWED expected_count)
    if(NOT count EQUAL expected_count OR NOT unique_count EQUAL expected_count)
        message(FATAL_ERROR "Expected each reviewed BLUFI source exactly once, found ${count}/${unique_count}")
    endif()
    set_property(TARGET ${component_lib} PROPERTY SOURCES "${replacements}")
    target_include_directories(${component_lib} PRIVATE "${AUDREAM_BLUFI_ROOT}/main/watch")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${AUDREAM_BLUFI_ROOT}/patches/esp-idf-5.5.4-blufi-security.patch"
        "${component_dir}/${AUDREAM_BLUFI_BTA_HEADER}")
    foreach(relative IN LISTS seen)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${component_dir}/${relative}")
    endforeach()
endfunction()
