{
    "manufacturer": "waveshare",
    "target": "esp32s3",
    "builds": [
        {
            "name": "esp32-s3-touch-amoled-2.06",
            "sdkconfig_append": [
                "CONFIG_USE_ESP_BLUFI_WIFI_PROVISIONING=y",
                "CONFIG_AUDREAM_WATCH_UI=y",
                "CONFIG_AUDREAM_WATCH_ANDROID_NOTIFICATIONS=y",
                "CONFIG_AUDREAM_WATCH_DEVICE_PAIRING=y",
                "CONFIG_USE_WECHAT_MESSAGE_STYLE=n",
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n",
                "CONFIG_SR_WN_WN9_XIAOLONGXIAOLONG_TTS=y",
                "CONFIG_PM_ENABLE=y",
                "CONFIG_FREERTOS_USE_TICKLESS_IDLE=y",
                "CONFIG_BT_CTRL_MODEM_SLEEP=y",
                "CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y",
                "CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y",
                "CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y",
                "CONFIG_BT_ACL_CONNECTIONS=1",
                "# CONFIG_BT_MULTI_CONNECTION_ENBALE is not set",
                "CONFIG_BT_CTRL_BLE_MAX_ACT=2",
                "CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y",
                "CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y",
                "CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2",
                "CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16",
                "CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y",
                "# CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER is not set",
                "CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4",
                "CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16",
                "CONFIG_ESP_WIFI_RX_BA_WIN=2",
                "CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8",
                "CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768",
                "CONFIG_LWIP_TCP_WND_DEFAULT=32768",
                "CONFIG_ESP_WIFI_IRAM_OPT=y",
                "# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set",
                "# CONFIG_LWIP_IRAM_OPTIMIZATION is not set",
                "CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/32m_watch.csv\"",
                "# CONFIG_LIBC_NEWLIB_NANO_FORMAT is not set"
            ]
        }
    ]
}
