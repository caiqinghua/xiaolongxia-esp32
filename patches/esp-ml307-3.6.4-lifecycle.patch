+
+bool EspTcp::DisconnectWithin(uint32_t timeout_ms) {
+    if (connected_.exchange(false)) disconnect_notification_pending_ = true;
+    // Keep the descriptor and task handle until the receive task acknowledges.
+    if (tcp_fd_ >= 0) shutdown(tcp_fd_, SHUT_RDWR);
+    if (receive_task_handle_ != nullptr) {
+        if (xTaskGetCurrentTaskHandle() == receive_task_handle_) return false;
+        const auto ticks = timeout_ms == UINT32_MAX ? portMAX_DELAY : pdMS_TO_TICKS(timeout_ms);
+        const auto bits = xEventGroupWaitBits(event_group_, ESP_TCP_EVENT_RECEIVE_TASK_EXIT,
+                                             pdFALSE, pdFALSE, ticks);
+        if (!(bits & ESP_TCP_EVENT_RECEIVE_TASK_EXIT)) return false;
+        receive_task_handle_ = nullptr;
+    }
+    if (tcp_fd_ >= 0) {
+        close(tcp_fd_);
+        tcp_fd_ = -1;
+    }
+    const bool notify = disconnect_notification_pending_;
+    disconnect_notification_pending_ = false;
+    if (notify && disconnect_callback_) disconnect_callback_();
+    return true;
+}
