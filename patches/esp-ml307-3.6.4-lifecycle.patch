+    // Consume a TCP chunk incrementally; several valid messages may share it.
+    size_t offset = 0;
+    while (offset < data.size() && receive_enabled_) {
+        const size_t limit = handshake_completed_ ? kMaxMessageBytes + 10 : kMaxHandshakeBytes;
+        if (receive_buffer_.size() >= limit) {
+            RejectReceive();
+            return;
+        }
+        const size_t count = std::min(data.size() - offset,
+                                     std::min(size_t{1024}, limit - receive_buffer_.size()));
+        receive_buffer_.append(data.data() + offset, count);
+        offset += count;
+        ParseBufferedData();
+    }
+}
+
+void WebSocket::RejectReceive() {
+    // The receive task retires parsing; only the owner may join/destroy TCP.
+    if (!receive_enabled_.exchange(false)) return;
+    receive_buffer_.clear();
+    current_message_.clear();
+    is_fragmented_ = false;
+    const bool was_connected = connected_.exchange(false);
+    xEventGroupSetBits(handshake_event_group_, HANDSHAKE_FAILED_BIT);
+    ESP_LOGE(TAG, "Invalid or oversized WebSocket input; receive session retired");
+    if (on_error_) on_error_(-1);
+    if (was_connected && on_disconnected_) on_disconnected_();
+}
