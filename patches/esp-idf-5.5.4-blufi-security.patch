+bool audream_blufi_queue_notification(uint64_t lease, uint16_t connection, uint16_t attribute,
+    int length, const uint8_t* data)
+{
+    if (!lease || lease != audream_blufi_operation_lease() || !data || length <= 0 ||
+        length > BTA_GATT_MAX_ATTR_LEN || !audream_blufi_notify_current(connection, attribute, lease)) return false;
+    const uint64_t subscription = audream_blufi_notify_token(connection, attribute, lease);
+    if (!subscription) return false;
+    audream_blufi_bta_message_t* message = osi_malloc(sizeof(*message));
+    if (!message) return false;
+    memset(message, 0, sizeof(*message));
+    message->packet.hdr.event = BTA_GATTS_API_INDICATION_EVT;
+    message->packet.hdr.layer_specific = connection;
+    message->packet.hdr.offset = AUDREAM_BLUFI_BTA_TAG;
+    message->packet.hdr.len = sizeof(*message);
+    message->packet.attr_id = attribute;
+    message->packet.len = length;
+    memcpy(message->packet.value, data, length);
+    message->lease = lease;
+    message->subscription = subscription;
+    // BLUFI bypasses the public GATTS BTC API and owns only a BTU credit.
+    l2ble_update_att_acl_pkt_num(L2CA_ADD_BTU_NUM, NULL);
+    // ACKs may originate on BTU itself; never wait for that task's queue to drain.
+    if (!btu_task_post(SIG_BTU_BTA_MSG, message, 0)) {
+        l2ble_update_att_acl_pkt_num(L2CA_DECREASE_BTU_NUM, NULL);
+        osi_free(message);
+        return false;
+    }
+    return true;
+}
