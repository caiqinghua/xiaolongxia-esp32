+#include "watch_blufi_notify.h"
+#include "freertos/FreeRTOS.h"
@@ -42,1 +43,12 @@
 static uint16_t conn_id;
+typedef enum {
+    AUDREAM_START_IDLE, AUDREAM_START_REGISTERING, AUDREAM_START_CREATING,
+    AUDREAM_START_WRITE_CHAR, AUDREAM_START_READ_CHAR, AUDREAM_START_DESCRIPTOR,
+    AUDREAM_START_SERVICE, AUDREAM_START_READY, AUDREAM_START_FAILED
+} audream_startup_phase_t;
+typedef struct {
+    audream_startup_phase_t startup;
+    bool connected;
+    uint16_t connection;
+    uint16_t attribute;
+    uint8_t address[6];
+    uint64_t previous_lease;
+    uint64_t notify_lease;
+    uint64_t epoch;
+} audream_host_state_t;
+static portMUX_TYPE audream_host_mux = portMUX_INITIALIZER_UNLOCKED;
+static audream_host_state_t audream_host_state;
+
+static audream_host_state_t audream_host_snapshot(void)
+{
+    portENTER_CRITICAL(&audream_host_mux);
+    const audream_host_state_t state = audream_host_state;
+    portEXIT_CRITICAL(&audream_host_mux);
+    return state;
+}
+
+// Called only while holding audream_host_mux. No SDK calls inside this lock.
+static void audream_invalidate_subscription(void)
+{
+    audream_host_state.notify_lease = 0;
+    if (audream_host_state.epoch != UINT64_MAX) ++audream_host_state.epoch;
+}
+
+static void audream_host_connection(bool connected, uint16_t connection, const uint8_t* address, uint64_t previous)
+{
+    portENTER_CRITICAL(&audream_host_mux);
+    audream_invalidate_subscription();
+    audream_host_state.connected = connected;
+    audream_host_state.connection = connection;
+    memcpy(audream_host_state.address, address, sizeof(audream_host_state.address));
+    audream_host_state.previous_lease = previous;
+    portEXIT_CRITICAL(&audream_host_mux);
+}
+
+static void audream_host_attribute(uint16_t attribute)
+{
+    portENTER_CRITICAL(&audream_host_mux);
+    audream_invalidate_subscription();
+    audream_host_state.attribute = attribute;
+    portEXIT_CRITICAL(&audream_host_mux);
+}
+
+static uint64_t audream_snapshot_lease(audream_host_state_t state)
+{
+    if (!state.connected || state.startup != AUDREAM_START_READY || state.epoch == UINT64_MAX) return 0;
+    const uint64_t lease = audream_blufi_control_lease(BTC_GATT_GET_CONN_ID(state.connection), state.address);
+    const audream_host_state_t after = audream_host_snapshot();
+    return lease && lease != state.previous_lease && state.epoch == after.epoch ? lease : 0;
+}
+
+static uint64_t audream_current_control_lease(uint16_t requested_connection)
+{
+    const audream_host_state_t state = audream_host_snapshot();
+    return requested_connection == state.connection ? audream_snapshot_lease(state) : 0;
+}
+
+uint64_t audream_blufi_transport_lease(void)
+{
+    return audream_snapshot_lease(audream_host_snapshot());
+}
+
+static uint64_t audream_operation_control_lease(uint16_t connection)
+{
+    const uint64_t lease = audream_current_control_lease(connection);
+    return lease && lease == audream_blufi_operation_lease() ? lease : 0;
+}
+
+bool audream_blufi_is_notify_handle(uint16_t attribute)
+{
+    return attribute && attribute == audream_host_snapshot().attribute;
+}
+
+bool audream_blufi_notify_current(uint16_t connection, uint16_t attribute, uint64_t lease)
+{
+    return audream_blufi_notify_token(connection, attribute, lease) != 0;
+}
+
+uint64_t audream_blufi_notify_token(uint16_t connection, uint16_t attribute, uint64_t lease)
+{
+    const audream_host_state_t state = audream_host_snapshot();
+    if (!lease || connection != state.connection || !attribute || attribute != state.attribute ||
+        lease != state.notify_lease || lease != audream_snapshot_lease(state) ||
+        lease != audream_blufi_operation_lease()) return 0;
+    return state.epoch == audream_host_snapshot().epoch ? state.epoch : 0;
+}
+
+static tBTA_GATT_STATUS audream_host_subscribe(uint16_t connection, uint64_t lease, bool enable)
+{
+    const audream_host_state_t state = audream_host_snapshot();
+    if (!lease || connection != state.connection || lease != audream_snapshot_lease(state))
+        return GATT_INSUF_AUTHENTICATION;
+    portENTER_CRITICAL(&audream_host_mux);
+    tBTA_GATT_STATUS result = GATT_INSUF_AUTHENTICATION;
+    if (state.epoch == audream_host_state.epoch) {
+        audream_invalidate_subscription();
+        result = enable && audream_host_state.epoch == UINT64_MAX ? GATT_INSUF_RESOURCE : GATT_SUCCESS;
+        if (result == GATT_SUCCESS && enable) audream_host_state.notify_lease = lease;
+    }
+    portEXIT_CRITICAL(&audream_host_mux);
+    return result;
+}
+
+static bool audream_startup_transition(audream_startup_phase_t expected, audream_startup_phase_t next)
+{
+    portENTER_CRITICAL(&audream_host_mux);
+    const bool accepted = audream_host_state.startup == expected;
+    if (accepted) {
+        audream_host_state.startup = next;
+        audream_invalidate_subscription();
+    }
+    portEXIT_CRITICAL(&audream_host_mux);
+    return accepted;
+}
+
+static void audream_startup_reset(audream_startup_phase_t phase)
+{
+    portENTER_CRITICAL(&audream_host_mux);
+    audream_host_state.startup = phase;
+    audream_host_state.connected = false;
+    audream_host_state.attribute = 0;
+    audream_invalidate_subscription();
+    portEXIT_CRITICAL(&audream_host_mux);
+}
+
+static void audream_startup_complete(bool success)
+{
+    const audream_startup_phase_t phase = audream_host_snapshot().startup;
+    if (phase < AUDREAM_START_REGISTERING || phase > AUDREAM_START_SERVICE ||
+        (success && phase != AUDREAM_START_SERVICE)) return;
+    if (!audream_startup_transition(phase, success ? AUDREAM_START_READY : AUDREAM_START_FAILED)) return;
+    esp_blufi_cb_param_t param = {0};
+    btc_msg_t msg = {0};
+    msg.sig = BTC_SIG_API_CB;
+    msg.pid = BTC_PID_BLUFI;
+    msg.act = ESP_BLUFI_EVENT_INIT_FINISH;
+    param.init_finish.state = success ? ESP_BLUFI_INIT_OK : ESP_BLUFI_INIT_FAILED;
+    if (btc_transfer_context(&msg, &param, sizeof(param), NULL, NULL) != BT_STATUS_SUCCESS) {
+        audream_startup_transition(AUDREAM_START_READY, AUDREAM_START_FAILED);
+        BTC_TRACE_ERROR("BLUFI startup result queue rejected the event\n");
+    }
+}
+
