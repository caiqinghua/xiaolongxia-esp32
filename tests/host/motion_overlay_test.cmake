cmake_minimum_required(VERSION 3.20)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${root}/cmake/audream_motion_overlay.cmake")
if(NOT DEFINED SENSORLIB OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "SENSORLIB and OUTPUT are required")
endif()
file(SHA256 "${SENSORLIB}/src/platform/SensorCommBase.hpp" original_hash)
audream_prepare_motion_overlay("${SENSORLIB}" "${OUTPUT}")
file(SHA256 "${OUTPUT}/src/platform/SensorCommBase.hpp" patched_hash)
if(original_hash STREQUAL patched_hash)
    message(FATAL_ERROR "The lifecycle patch was not applied")
endif()
audream_prepare_motion_overlay("${SENSORLIB}" "${OUTPUT}")
file(SHA256 "${OUTPUT}/src/platform/SensorCommBase.hpp" repeated_hash)
file(SHA256 "${SENSORLIB}/src/platform/SensorCommBase.hpp" unchanged_hash)
if(NOT repeated_hash STREQUAL patched_hash OR NOT original_hash STREQUAL unchanged_hash)
    message(FATAL_ERROR "Motion overlay changed original sources or is not repeatable")
endif()
message(STATUS "Motion overlay: pinned-source, patch, and repeatability checks passed")
